# Copie este arquivo para `.env` e preencha com os valores do seu projeto Supabase.
# (Supabase: Dashboard > Project Settings > API)
#
# Importante: esses valores são públicos no frontend (chave anônima) e ficam
# expostos no deploy. A segurança real dos dados é garantida pelas políticas RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# Opcional: base path para deploy em subpasta do GitHub Pages.
# Ex.: para https://usuario.github.io/Financial-solution/ use VITE_BASE=/Financial-solution/
VITE_BASE=/